meta {
  name: List comments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products/:productId/comments
  body: none
  auth: none
}

params:path {
  productId: 264a6a79-e6df-4da7-8c03-a8698a7272b1
}

headers {
  Accept: application/json
}

tests {
  test("should return a list", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Retrieves the comments associated with the selected product. Edit productId in the Params tab to target a different product.
}
