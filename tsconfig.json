{
    "compilerOptions": {
        "paths": {
            "#src/*": ["./src/*.ts"],
            "#v1/*": ["./src/v1/*.ts"],
            "#shared/*": ["./src/shared/*.ts"]
        },
        "target": "esnext",
        "module": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": false,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true
    }
}
