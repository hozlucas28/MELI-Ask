{
    "name": "MELI-Ask",
    "version": "1.0.0",
    "type": "module",
    "imports": {
        "#src/*": "./src/*.ts",
        "#v1/*": "./src/v1/*.ts",
        "#shared/*": "./src/shared/*.ts"
    },
    "scripts": {
        "start": "node src/api.ts",
        "dev": "node --watch --env-file=.env src/api.ts",
        "test": "cd docs/bruno && bru run --tests-only --noproxy",
        "fmt": "oxfmt",
        "lint": "tsc --noEmit && oxlint --fix && zizmor --gh-token=$(gh auth token) --persona=auditor .github/workflows && github-actionlint -ignore 'unexpected key \"description\" for \"workflow\" section.' .github/workflows/*.yaml",
        "check:spelling": "cspell ."
    },
    "dependencies": {
        "@openrouter/agent": "0.11.0",
        "@openrouter/sdk": "^1.2.147",
        "compression": "^1.8.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "pg": "^8.23.0",
        "pgvector": "^0.3.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cspell/dict-es-es": "^3.0.8",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.1",
        "@types/pg": "^8.23.1",
        "@usebruno/cli": "^4.1.0",
        "cspell": "^10.3.3",
        "github-actionlint": "^1.7.12",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.11.0",
            "onFail": "download"
        }
    }
}
