
LOG_LEVEL=info

# Application
APP_URL=http://localhost:3000
APP_PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=meli_ask
DATABASE_PASSWORD=meli_ask
DATABASE_APP_DATABASE=meli_ask

# Frontend
FRONTEND_PORT=5173

# OpenRouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY # Go to https://openrouter.ai/workspaces/default/keys and create an OpenRouter API key.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Observability
SENTRY_DSN=YOUR_SENTRY_DSN # Go to your Sentry project and create a Sentry DSN.
SENTRY_ENVIRONMENT=development

# Semantic RAG cache
REDIS_URL=redis://localhost:6379
